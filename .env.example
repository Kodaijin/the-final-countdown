# Copy to .env and set COUNTDOWN_TARGET. There is no default deadline: if this is
# blank the container refuses to start and the page says "NO DEADLINE SET".

# When the countdown ends. Either a wall-clock time read in COUNTDOWN_TZ below
# (YYYY-MM-DDTHH:MM[:SS]) or an absolute instant ("2026-10-30T01:00:00Z",
# "2026-10-29T18:00:00-07:00"), in which case the zone is only used for display.
COUNTDOWN_TARGET=

# IANA timezone the target is written in. Leave blank to use each viewer's own
# timezone. Setting it means you never have to work out daylight saving yourself.
COUNTDOWN_TZ=America/Los_Angeles

# Caption under the clock. Blank = generated from the target, e.g. "Oct 29, 2026, 6:00 PM PDT".
COUNTDOWN_LABEL=

# Flight to track live once the countdown hits zero. A flight number ("UA 1",
# "AA100"), its ADS-B callsign ("UAL1"), or the plane's tail number ("N81110",
# "C-FTJP"). Blank = the page just says TIME'S UP.
COUNTDOWN_FLIGHT=

# Where that flight goes, as two IATA airport codes: "SFO-ICN". Optional - blank
# looks the route up from the flight number, but that public database is often
# out of date for domestic flights, so set it if you know it. It drives the map
# line, the distance to go and the arrival estimate.
COUNTDOWN_ROUTE=
