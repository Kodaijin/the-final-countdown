# Copy to .env and set COUNTDOWN_TARGET. There is no default deadline: if this is
# blank the container refuses to start and the page says "NO DEADLINE SET".

# When the countdown ends. Either a wall-clock time read in COUNTDOWN_TZ below
# (YYYY-MM-DDTHH:MM[:SS]) or an absolute instant ("2026-10-30T01:00:00Z",
# "2026-10-29T18:00:00-07:00"), in which case the zone is only used for display.
COUNTDOWN_TARGET=

# IANA timezone the target is written in. Leave blank to use each viewer's own
# timezone. Setting it means you never have to work out daylight saving yourself.
# For a flight, use the zone of the airport it leaves from.
COUNTDOWN_TZ=America/Los_Angeles

# Caption under the clock. Blank = generated from the target, e.g. "Oct 29, 2026, 6:00 PM PDT".
COUNTDOWN_LABEL=

# Flight to track live once the countdown hits zero. A flight number ("UA 1",
# "AA100"), its ADS-B callsign ("UAL1"), or the plane's tail number ("N81110",
# "C-FTJP"). For a connection, list the flights in order: "AS 414, AS 488" -
# each is followed until it lands, then the next. Blank = just TIME'S UP.
COUNTDOWN_FLIGHT=

# Where the flight goes, as IATA airport codes: "SFO-ICN", or for a connection
# "PIT-SEA-PDX" (one more airport than flights). Optional - blank looks routes
# up from the flight numbers, but that public database is often out of date, so
# set it if you know it. It drives the map, distance to go and arrival estimate.
COUNTDOWN_ROUTE=

# The background viewers see first. Each viewer can still switch with the picker
# in the corner (remembered in their browser) or ?bg= on the URL.
#   synthwave   neon sun and grid (blank = this)
#   hyperspace  starfield that goes to light speed at the end
#   globe       Earth turning with COUNTDOWN_ROUTE drawn on it
#   board       split-flap departures board, your flight on top
#   aurora      northern lights over mountains
COUNTDOWN_BG=
